# .env.example – Template biến môi trường
# Copy file này thành .env và điền các giá trị thật
# KHÔNG commit file .env lên git

# ----------------------------
# PostgreSQL / PostGIS Database
# ----------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salinity_webgis
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# ----------------------------
# FastAPI Backend
# ----------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
# SECRET_KEY dùng cho JWT nếu sau này thêm auth
SECRET_KEY=replace_with_a_strong_random_secret_key

# ----------------------------
# Data Paths (tùy chỉnh nếu cần)
# ----------------------------
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# ----------------------------
# Optional: External APIs
# ----------------------------
# Open-Meteo không cần API key (free tier)
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
