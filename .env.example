# Copy to .env locally; never commit credentials.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=dongthap_gis
# Deployment administrator for setup/import scripts only. Never used by the API after setup.
PGUSER=postgres
# Set PGPASSWORD locally or use PGPASSFILE.
# PGPASSFILE=C:/Users/your-user/AppData/Roaming/postgresql/pgpass.conf
WEBGIS_RESEARCH_MODE=postgres
# Apply scripts/apply_dss_storage.py --apply before enabling PostgreSQL history/drafts.
WEBGIS_DSS_WRITES_ENABLED=false
# DSS_PGUSER=webgis_writer
# WEBGIS_RESEARCH_FILE=data/research/workspace.json
# WEBGIS_RESEARCH_SNAPSHOT_ID=<imported snapshot id>
WEBGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# run_webgis.py loads .env; select listening port with --port.

# Generated by scripts/setup_security.py --apply; do not reuse admin credentials.
WEBGIS_DB_USER=webgis_reader
# WEBGIS_DB_PASSWORD=<generated locally>
DSS_PGUSER=webgis_writer
# DSS_PGPASSWORD=<generated locally>
WEBGIS_SECURITY_ENABLED=true
WEBGIS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional API clients: when configured, POST history/drafts requires X-API-Key.
# WEBGIS_WRITE_API_KEY=<random secret, never put in frontend build>
# Remote PostgreSQL: configure certificate trust and PGSSLMODE=verify-full.
