  "data_status": "Retrospective revised snapshots, source EC UNVERIFIED; not live operational validation",
  "primary_ec_delay_days": 0,
  "sensitivity_ec_delay_days": 30,
  "weather_delay_days": 5,
  "enso_delay_days": 30,
